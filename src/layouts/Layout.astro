---
// src/layouts/Layout.astro
// We might import a global CSS file later if needed
import '../styles/global.css';
import Header from '../components/Header.astro'; // Import the Header component we will create
import Footer from '../components/Footer.astro';
import NewsBanner from '../components/NewsBanner.astro';

interface Props {
    title: string;
    description?: string;
    project: 'ragen' | 'lagen';
}

const { title, description = 'RAGEN-2: Reasoning Collapse in Agentic RL', project } = Astro.props as Props;
const basePath = import.meta.env.BASE_URL;
const isLagen = project === 'lagen';
const logo = isLagen ? `${basePath}lagen/favicon.svg` : `${basePath}icon.png`;
const home = isLagen ? `${basePath}lagen/` : basePath;
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type={isLagen ? 'image/svg+xml' : 'image/png'} href={logo} />
        <link rel="apple-touch-icon" href={logo} />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {/* We can link fonts or global styles here if necessary */}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    </head>
    <body class:list={{ 'lagen-site': isLagen }}>
        <Header project={project} home={home} logo={logo} />
        <NewsBanner /> {/* Workshop announcement banner */}
        <main>
            <slot /> {/* Page content from index.astro goes here */}
        </main>
        <Footer />
    </body>
</html>

<style is:global>
	:root {
		--header-height: 60px;
		--page-max-width: 1100px;
		--text-light: #555;
	}
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}
	html {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		font-size: 19px;
		color: #252525;
		scroll-behavior: smooth;
	}
	html, body {
		min-height: 100vh;
		overflow-x: hidden;
		max-width: 100%;
	}
	main {
		padding-top: var(--header-height);
	}
</style>
