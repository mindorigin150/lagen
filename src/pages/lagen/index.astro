---
import Layout from '../../layouts/Layout.astro';
import AuthorsCitation from '../../components/AuthorsCitation.astro';
import LatencyActionDock from '../../components/LatencyActionDock.astro';
import showcase from '../../data/real-latency-showcase.json';
import '../../styles/section.css';
import '../../styles/hero.css';
import '../../styles/authors.css';
import '../../styles/resources.css';
import '../../styles/lagen.css';

const basePath = import.meta.env.BASE_URL;
const asset = (name: string) => `${basePath}lagen/${name}`;
const mediaVersion = '20260819b';
const mediaAsset = (name: string) => `${asset(name)}?v=${mediaVersion}`;
const demoGroups = [
  {
    id: 'flappy',
    title: 'Flappy Bird',
    mediaWidth: 576,
    mediaHeight: 424,
    defaultLatency: 3,
  },
  {
    id: 'demon_attack',
    title: 'Demon Attack',
    mediaWidth: 576,
    mediaHeight: 378,
    defaultLatency: 8,
  },
  {
    id: 'deadly_corridor',
    title: 'Deadly Corridor',
    mediaWidth: 576,
    mediaHeight: 216,
    defaultLatency: 8,
  },
];
const carouselData = demoGroups.map((group) => ({
  id: group.id,
  title: group.title,
  mediaWidth: group.mediaWidth,
  mediaHeight: group.mediaHeight,
  defaultLatency: group.defaultLatency,
  videos: showcase.filter((candidate) => candidate.game === group.id).map((candidate, index) => {
    return {
      envFps: candidate.envFps,
      requests: candidate.requests,
      fps: candidate.fps,
      poster: mediaAsset(candidate.poster),
      variants: candidate.variants.map((variant) => ({
        latencyRawFrames: variant.latencyRawFrames,
        video: mediaAsset(variant.video),
      })),
      label: `${group.title} example ${index + 1}`,
    };
  }),
}));
const initialCarouselGroup = carouselData[0];
const initialCarouselPositions = ['left', 'center', 'right'];
const initialLatency = initialCarouselGroup.defaultLatency;
const initialLatencyMs = Math.round(initialLatency / initialCarouselGroup.videos[0].envFps * 1000);
const initialVariants = initialCarouselGroup.videos[0].variants;
const pageTitle = 'LAGEN: Latency-Aware Agents';
const citation = `@misc{latencyawareagents2026,
  title={The Cost of Thinking: Evaluating Latency Sensitivity in Real-Time Foundation Model Agents},
  author={Anonymous Authors},
  year={2026},
  note={Anonymous research draft}
}`;
---

<Layout title={pageTitle} description="LAGEN: Latency-Aware Agents" project="lagen">
  <section id="hero" class="content-section hero-section">
    <div class="title-wrapper">
      <div class="title-with-logo">
        <img src={asset('favicon.svg')} alt="LAGEN Logo" class="title-logo" />
        <h1 class="main-title" id="animated-title">LAGEN</h1>
      </div>
      <p class="title-subtitle">Latency-Aware Agents</p>
    </div>

    <p class="main-subtitle">
      <strong>The Cost of Thinking</strong>: evaluating latency sensitivity in real-time foundation model agents.
    </p>
    <p class="main-subtitle lagen-summary">
      A correct action can still fail when inference moves it onto the wrong state. We profile the deployment clock,
      replay its temporal structure, and condition agents on the latency regime they must control through.
    </p>

    <div class="authors-section compact">
      <div class="authors-list">
        <p class="author-line">
          <a href="https://zihanwang314.github.io/">Zenus Wang</a><sup>*&dagger;1</sup>,
          <a href="https://chigui0.github.io/">Chi Gui</a><sup>&dagger;2</sup>,
          <a href="#">Xing Jin</a><sup>&dagger;3</sup>,
          <a href="https://qinengwang-aiden.github.io/">Qineng Wang</a><sup>&dagger;1</sup>,
          <a href="https://lichengliu03.github.io/">Licheng Liu</a><sup>4</sup>,
          <a href="https://jameskrw.github.io/">Kangrui Wang</a><sup>1</sup>
        </p>
        <p class="author-line">
          <a href="https://shiqichen17.github.io/">Shiqi Chen</a><sup>5</sup>,
          <a href="https://scholar.google.com/citations?user=WR875gYAAAAJ&hl=en">Linjie Li</a><sup>6</sup>,
          <a href="https://zyang-ur.github.io/">Zhengyuan Yang</a><sup>7</sup>,
          <a href="https://williamzhangsjtu.github.io/">Pingyue Zhang</a><sup>1</sup>,
          <a href="https://2prime.github.io/">Yiping Lu</a><sup>1</sup>,
          <a href="https://jiajunwu.com/">Jiajun Wu</a><sup>8</sup>,
          <a href="https://profiles.stanford.edu/fei-fei-li">Li Fei-Fei</a><sup>8</sup>
        </p>
        <p class="author-line">
          <a href="https://www.microsoft.com/en-us/research/people/lijuanw/">Lijuan Wang</a><sup>7</sup>,
          <a href="https://homes.cs.washington.edu/~yejin/">Yejin Choi</a><sup>8</sup>,
          <a href="https://limanling.github.io/">Manling Li</a><sup>1</sup>
        </p>
        <p class="equal-contribution"><sup>&dagger;</sup> Core Contributors &nbsp;&nbsp; <sup>*</sup> Project Lead</p>
        <p class="affiliations"><sup>1</sup>Northwestern University &nbsp; <sup>2</sup>UIUC &nbsp; <sup>3</sup>University of British Columbia &nbsp; <sup>4</sup>Imperial College London &nbsp; <sup>5</sup>City University of Hong Kong &nbsp; <sup>6</sup>University of Washington &nbsp; <sup>7</sup>Microsoft &nbsp; <sup>8</sup>Stanford University</p>
      </div>
    </div>

    <div class="resources-section">
      <div class="resources-buttons">
        <a href={asset('Latency_Aware_Agents_Paper_Draft.pdf')} class="resource-button" target="_blank" rel="noopener noreferrer">
          <i class="fas fa-file-alt resource-icon" aria-hidden="true"></i><span>Paper</span>
        </a>
        <a href="#citation" class="resource-button">
          <i class="fas fa-clipboard resource-icon" aria-hidden="true"></i><span>Citation</span>
        </a>
        <a href="https://www.mll.lab.northwestern.edu/" class="resource-button" target="_blank" rel="noopener noreferrer">
          <i class="fas fa-external-link-alt resource-icon" aria-hidden="true"></i><span>MLL Lab</span>
        </a>
      </div>
    </div>

    <div
      class="curated-demo-showcase latency-carousel"
      data-latency-carousel
      data-carousel-data={JSON.stringify(carouselData)}
      data-carousel-environment={demoGroups[0].id}
      aria-labelledby="latency-in-action"
    >
      <h2 id="latency-in-action" class="curated-demo-title">Latency in Action</h2>
      <p class="curated-demo-intro">The same recorded policy request stream is replayed from one simulator state: immediate on the left, delayed on the right.</p>
      <div class="latency-carousel-tabs" role="tablist" aria-label="Choose an environment">
        {demoGroups.map((group, index) => (
          <button
            class="latency-carousel-tab"
            id={`latency-tab-${group.id}`}
            type="button"
            role="tab"
            aria-controls="latency-carousel-panel"
            aria-selected={index === 0}
            tabindex={index === 0 ? 0 : -1}
            data-carousel-tab
          >
            <span>{group.title}</span>
          </button>
        ))}
      </div>

      <div class="latency-control">
        <label class="latency-control-label" for="latency-raw-frames">
          Right-side inference latency
          <output for="latency-raw-frames">
            <span data-latency-frames>{initialLatency} raw frames</span>
            <span aria-hidden="true"> · </span>
            <span data-latency-ms>{initialLatencyMs} ms</span>
          </output>
        </label>
        <input
          id="latency-raw-frames"
          class="latency-control-range"
          type="range"
          min={initialVariants[0].latencyRawFrames}
          max={initialVariants[initialVariants.length - 1].latencyRawFrames}
          step={initialVariants[1].latencyRawFrames - initialVariants[0].latencyRawFrames}
          value={initialLatency}
          aria-label={`Right-side inference latency for ${initialCarouselGroup.title}`}
          data-latency-slider
        />
      </div>

      <p class="latency-carousel-context" data-carousel-context></p>

      <div class="latency-carousel-stage">
        <button class="latency-carousel-arrow latency-carousel-arrow-prev" type="button" data-carousel-prev aria-label="Previous comparison">
          <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <div
          class="latency-carousel-viewport"
          id="latency-carousel-panel"
          role="tabpanel"
          aria-labelledby="latency-tab-flappy"
          data-carousel-viewport
        >
          <div class="latency-carousel-track" data-carousel-track>
            {initialCarouselGroup.videos.map((item, index) => (
              <article
                class="latency-carousel-slide"
                data-carousel-slide
                aria-hidden={index !== 1}
                aria-label={item.label}
                role="group"
                tabindex={index === 1 ? 0 : -1}
                data-carousel-position={initialCarouselPositions[index]}
                class:list={{ 'is-active': index === 1 }}
              >
                <div class="latency-carousel-media-well">
                  <figure class="curated-demo-card" data-carousel-media>
                    <video
                      class="curated-demo-video"
                      src={item.variants.find((variant) => variant.latencyRawFrames === initialLatency)!.video}
                      poster={item.poster}
                      width={initialCarouselGroup.mediaWidth}
                      height={initialCarouselGroup.mediaHeight}
                      muted
                      loop
                      playsinline
                      autoplay={index === 1}
                      preload={index === 1 ? 'metadata' : 'none'}
                      aria-label={item.label}
                      tabindex="-1"
                      data-carousel-video
                    ></video>
                  </figure>
                  <div class="latency-action-docks">
                    <div class="latency-action-dock-slot"><LatencyActionDock /></div>
                    <div class="latency-action-dock-slot"><LatencyActionDock /></div>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
        <span class="latency-carousel-count" aria-live="polite"><span data-carousel-current>02</span><span aria-hidden="true"> / 03</span></span>
        <button class="latency-carousel-arrow latency-carousel-arrow-next" type="button" data-carousel-next aria-label="Next comparison">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </section>

  <section id="method" class="content-section alt-background lagen-section">
    <div class="section-container">
      <h2 class="section-title">Method</h2>
      <div class="method-block">
        <div class="method-block-header"><span class="method-tag">Protocol</span><h3>Separate the observation clock from the inference clock</h3></div>
        <div class="method-block-body">
          <p class="method-desc">We decouple environment cadence <em>T<sub>k</sub></em> from inference delay <em>&delta;<sub>k</sub></em>, so fixed delays, stochastic jitter, and measured hardware traces become reproducible evaluation conditions.</p>
          <img src={asset('figures/protocol.png')} alt="Observation cadence and inference latency in a real-time agent" class="paper-fig" loading="lazy" />
          <p class="fig-caption"><strong>Protocol.</strong> A decision is executed when it arrives, not when it is requested. World-pausing evaluation is the <em>&delta; = 0</em> special case.</p>
          <div class="equation-box lagen-equation"><span><strong>T<sub>k</sub></strong> observation cadence</span><span><strong>&delta;<sub>k</sub></strong> inference delay</span><span><strong>&tau;<sub>k</sub></strong> action arrival time</span></div>
        </div>
      </div>
      <div class="method-block">
        <div class="method-block-header"><span class="method-tag">Deployment</span><h3>Profile once, replay the temporal structure</h3></div>
        <div class="method-block-body"><p class="method-desc">End-to-end latency is treated as part of the task condition. A measured profile can be replayed on a faster host for controlled policy comparisons and same-device calibration.</p></div>
      </div>
    </div>
  </section>

  <section id="results" class="content-section lagen-section">
    <div class="section-container">
      <h2 class="section-title">Experiments</h2>
      <p class="section-subtitle">Eight views of how the deployment clock changes agent behavior.</p>

      <div class="rq-block" id="rq1">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq1-body"><span class="rq-badge">01</span><h3>Deployment profiling and replay calibration</h3><span class="rq-summary">A temporal replay preserves the behavior of a measured execution clock.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq1-body">
          <h4 class="rq-subheading">Measure the clock, then replay its shape</h4>
          <div class="rq-figure-stack">
            <figure class="rq-profile-figure"><img src={asset('figures/latency-profile-consecutive.png')} alt="Consecutive cross-device latency profiles" class="rq-fig" loading="lazy" /><figcaption>Measured consecutive latency distributions across five GPU classes.</figcaption></figure>
            <figure><img src={asset('figures/latency-modeling-consecutive.png')} alt="Real versus replay-predicted return under consecutive latency profiles" class="rq-fig" loading="lazy" /><figcaption>Replay calibration by sampling method; lower return gap is better.</figcaption></figure>
          </div>
          <p class="rq-caption">Temporal replay has the smallest average real-to-sim return gap (10.8), compared with IID (18.1), Normal (44.1), and Fixed (87.4). The result supports replaying the measured temporal process rather than replacing it with a mean-only approximation.</p>
        </div>
      </div>

      <div class="rq-block" id="rq2">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq2-body"><span class="rq-badge">02</span><h3>Cross-model latency degradation</h3><span class="rq-summary">Non-zero execution delay destabilizes existing VLA policies across tasks.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq2-body">
          <h4 class="rq-subheading">The same brittleness appears across VLA families</h4>
          <img src={asset('figures/vla-degradation.png')} alt="OpenVLA, pi0.5, and GR00T scores under increasing evaluation latency" class="rq-fig" loading="lazy" />
          <p class="rq-caption">OpenVLA, π<sub>0.5</sub>, and GR00T are trained at zero latency and evaluated with increasing fixed delay. Flappy Bird and Demon Attack show the sharpest collapse; Deadly Corridor declines more gradually but does not remain latency-invariant.</p>
        </div>
      </div>

      <div class="rq-block" id="rq3">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq3-body"><span class="rq-badge">03</span><h3>Train–evaluation latency matrices</h3><span class="rq-summary">Policies specialize near the latency they experience during training.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq3-body">
          <h4 class="rq-subheading">Small agents and VLAs show the same local structure</h4>
          <div class="rq-figure-stack">
            <figure><img src={asset('figures/train-eval-small-uncapped.png')} alt="Small-policy train and evaluation latency matrices" class="rq-fig" loading="lazy" /><figcaption>Small-policy robustness across fixed, stochastic, and mixed profiles.</figcaption></figure>
            <figure><img src={asset('figures/train-eval-vla.png')} alt="OpenVLA train and evaluation latency matrices" class="rq-fig" loading="lazy" /><figcaption>OpenVLA fixed-latency specialization across three environments.</figcaption></figure>
          </div>
          <p class="rq-caption">Performance is usually strongest on or near the training latency. Higher-latency specialists can sometimes transfer to shorter delays, while low-latency specialists degrade more sharply at longer delays. Mixed and stochastic training expand coverage, but no profile dominates every task.</p>
        </div>
      </div>

      <div class="rq-block" id="rq4">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq4-body"><span class="rq-badge">04</span><h3>Matched-mean latency jitter</h3><span class="rq-summary">Mean latency alone misses the destructive effect of temporal variance and tails.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq4-body">
          <h4 class="rq-subheading">Same mean, different control difficulty</h4>
          <img src={asset('figures/jitter-destructiveness.png')} alt="Relative small-model and VLA scores under matched-mean latency profiles" class="rq-fig" loading="lazy" />
          <p class="rq-caption">The fixed profile is normalized to 1.0 in each environment. Matched-mean stochastic profiles reduce both small-model and VLA return, while the latency density shows the variance and tail that a single mean hides.</p>
        </div>
      </div>

      <div class="rq-block" id="rq5">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq5-body"><span class="rq-badge">05</span><h3>Temporal resolution and span</h3><span class="rq-summary">Observation cadence and history length are both task- and profile-dependent.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq5-body">
          <h4 class="rq-subheading">Observation cadence: more frequent updates are not universally better</h4>
          <img src={asset('figures/observation-stride-uncapped.png')} alt="Return as a function of observation stride across three environments" class="rq-fig" loading="lazy" />
          <p class="rq-caption">The best observation stride changes with the environment and with the fixed or stochastic latency profile. Dense updates preserve fine-grained dynamics, while wider spacing can expose change over a longer physical interval.</p>
          <h4 class="rq-subheading">Context-window span: longer history helps selectively</h4>
          <img src={asset('figures/context-window-uncapped.png')} alt="Return as a function of context-window size across three environments" class="rq-fig" loading="lazy" />
          <p class="rq-caption">Additional frames substantially help Demon Attack over part of the sweep, but produce limited or non-monotonic gains in Flappy Bird and Deadly Corridor. Temporal context should be tuned along both resolution and span.</p>
        </div>
      </div>

      <div class="rq-block" id="rq6">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq6-body"><span class="rq-badge">06</span><h3>VLA temporal-memory interfaces</h3><span class="rq-summary">The representation of history matters as much as the amount of history.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq6-body">
          <h4 class="rq-subheading">Compare the interfaces at their final checkpoints</h4>
          <img src={asset('figures/memory-methods.svg')} alt="Single-frame, ghost-trail, streaming KV, four-frame prompt, and mosaic memory interfaces" class="rq-fig" loading="lazy" />
          <div class="rq-table-wrap"><img src={asset('figures/memory-comparison.png')} alt="Final memory-method comparison table across Flappy Bird, Demon Attack, and Deadly Corridor" class="rq-table" loading="lazy" /></div>
          <p class="rq-caption">There is no universal best interface: Ghost trail and WanOFT lead on Flappy Bird, KV Flex is highest on Demon Attack, and the 2×2 mosaic is highest on Deadly Corridor.</p>
        </div>
      </div>

      <div class="rq-block" id="rq7">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq7-body"><span class="rq-badge">07</span><h3>Timing representation probing</h3><span class="rq-summary">Ordered visual history carries timing information that can be decoded linearly.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq7-body">
          <h4 class="rq-subheading">Decodable timing is not automatically robust control</h4>
          <div class="rq-figure-stack">
            <figure><img src={asset('figures/timing-controls.png')} alt="Timing and action decodability under ordered and controlled inputs" class="rq-fig" loading="lazy" /><figcaption>Macro-F1 under ordered, shuffled, repeated-frame, and prompt-control inputs.</figcaption></figure>
            <figure><img src={asset('figures/timing-buckets.png')} alt="Timing decodability by decision-step distance" class="rq-fig" loading="lazy" /><figcaption>Per-class timing F1 by distance from the relevant action.</figcaption></figure>
          </div>
          <p class="rq-caption">Shuffling or repeating the current frame removes much of the signal. DiT temporal-delta features generally decode timing better than action-query features, but representation decodability alone does not prove causal use by the policy.</p>
        </div>
      </div>

      <div class="rq-block" id="rq8">
        <button class="rq-header" type="button" aria-expanded="false" data-target="rq8-body"><span class="rq-badge">08</span><h3>Is language latency representation in the prompt useful?</h3><span class="rq-summary">Explicit timing language can be essential when one policy spans mixed deployment clocks.</span><span class="rq-chevron" aria-hidden="true">&#8964;</span></button>
        <div class="rq-body" id="rq8-body">
          <h4 class="rq-subheading">A timing token changes action selection</h4>
          <img src={asset('figures/latency-prompt-ablation.png')} alt="OpenVLA mixed-latency Flappy Bird performance with and without a latency prompt" class="rq-fig" loading="lazy" />
          <p class="rq-caption">With explicit latency information, returns remain around 433.8, 434.0, 341.3, 290.3, and 267.6 across latencies 0–4; removing the prompt reduces them to roughly 18.8, 14.3, 9.4, 6.5, and 4.5. This establishes the importance of the prompt in this mixed-latency Flappy Bird setting, not a universal sufficiency claim.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section alt-background lagen-section">
    <div class="section-container"><h2 class="section-title">Conclusion</h2><div class="lagen-takeaways"><div><strong>01</strong><p>Latency changes which state receives an otherwise valid action.</p></div><div><strong>02</strong><p>Mean delay alone cannot reproduce destructive temporal tails.</p></div><div><strong>03</strong><p>Timing-aware training and explicit conditioning make deployment latency controllable.</p></div></div></div>
  </section>

  <AuthorsCitation citation={citation} />
</Layout>

<script src="../../scripts/latencyCarousel.ts"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headers = [...document.querySelectorAll<HTMLButtonElement>('.rq-header[data-target]')];
    const updateHeight = (header: HTMLButtonElement) => {
      const targetId = header.dataset.target!;
      const body = document.getElementById(targetId);
      if (body && header.getAttribute('aria-expanded') === 'true') body.style.maxHeight = `${body.scrollHeight}px`;
    };

    headers.forEach((header) => {
      header.addEventListener('click', () => {
        const targetId = header.dataset.target!;
        const body = document.getElementById(targetId)!;
        const open = header.getAttribute('aria-expanded') === 'true';
        headers.forEach((other) => {
          const otherBody = document.getElementById(other.dataset.target!);
          other.setAttribute('aria-expanded', other === header && !open ? 'true' : 'false');
          if (otherBody) otherBody.style.maxHeight = other === header && !open ? `${otherBody.scrollHeight}px` : '0px';
        });
      });
    });

    document.querySelectorAll<HTMLImageElement>('.rq-body img').forEach((image) => {
      image.addEventListener('load', () => {
        const body = image.closest<HTMLElement>('.rq-body');
        const header = body ? headers.find((candidate) => candidate.dataset.target === body.id) : undefined;
        if (header) updateHeight(header);
      });
    });
  });
</script>
