<div class="latency-action-dock" aria-hidden="true">
  <div class="latency-action-layout latency-action-layout-flappy">
    <span class="latency-action-key" data-action-key="flap">
      <i class="fas fa-arrow-up" aria-hidden="true"></i>
    </span>
  </div>

  <div class="latency-action-layout latency-action-layout-demon">
    <span class="latency-action-key" data-action-key="move-left">
      <i class="fas fa-arrow-left" aria-hidden="true"></i>
    </span>
    <span class="latency-action-key latency-action-key-fire" data-action-key="fire">FIRE</span>
    <span class="latency-action-key" data-action-key="move-right">
      <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </span>
  </div>

  <div class="latency-action-layout latency-action-layout-deadly">
    <div class="latency-action-keypad">
      <span class="latency-action-key" data-action-key="turn-left">
        <i class="fas fa-arrow-rotate-left" aria-hidden="true"></i>
      </span>
      <span class="latency-action-key" data-action-key="move-forward">
        <i class="fas fa-arrow-up" aria-hidden="true"></i>
      </span>
      <span class="latency-action-key latency-action-key-turn-right" data-action-key="turn-right">
        <i class="fas fa-arrow-rotate-left" aria-hidden="true"></i>
      </span>
      <span class="latency-action-key" data-action-key="move-left">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
      </span>
      <span class="latency-action-key" data-action-key="move-backward">
        <i class="fas fa-arrow-down" aria-hidden="true"></i>
      </span>
      <span class="latency-action-key" data-action-key="move-right">
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </span>
    </div>
    <span class="latency-action-key latency-action-key-fire" data-action-key="fire">FIRE</span>
  </div>
</div>
